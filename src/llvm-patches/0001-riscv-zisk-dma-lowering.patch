+void RISCVAsmPrinter::LowerZiskDma(const MachineInstr &MI) {
+  // CSR numbers of the ZISK DMA markers (see ziskos zisk_definitions and the
+  // transpiler in zisk/core/src/riscv2zisk_context.rs).
+  constexpr int64_t CsrMemcpy = 0x813;
+  constexpr int64_t CsrMemcmp = 0x814;
+  constexpr int64_t CsrMemset = 0x816;
+  const Register X0 = RISCV::X0;
+
+  auto Csrs = [&](int64_t Csr, Register Rs1) {
+    EmitToStreamer(*OutStreamer, MCInstBuilder(RISCV::CSRRS)
+                                     .addReg(X0)
+                                     .addImm(Csr)
+                                     .addReg(Rs1));
+  };
+
+  switch (MI.getOpcode()) {
+  default:
+    llvm_unreachable("Unexpected ZISK DMA pseudo");
+  case RISCV::PseudoZiskMemcpyImm: {
+    // csrs 0x813, src ; addi x0, dst, size
+    Csrs(CsrMemcpy, MI.getOperand(1).getReg());
+    EmitToStreamer(*OutStreamer, MCInstBuilder(RISCV::ADDI)
+                                     .addReg(X0)
+                                     .addReg(MI.getOperand(0).getReg())
+                                     .addImm(MI.getOperand(2).getImm()));
+    return;
+  }
+  case RISCV::PseudoZiskMemcpyReg: {
+    // csrs 0x813, src ; add x0, dst, sizereg
+    Csrs(CsrMemcpy, MI.getOperand(1).getReg());
+    EmitToStreamer(*OutStreamer, MCInstBuilder(RISCV::ADD)
+                                     .addReg(X0)
+                                     .addReg(MI.getOperand(0).getReg())
+                                     .addReg(MI.getOperand(2).getReg()));
+    return;
+  }
+  case RISCV::PseudoZiskMemcmpImm: {
+    // csrs 0x814, src ; addi res, dst, size
+    Csrs(CsrMemcmp, MI.getOperand(2).getReg());
+    EmitToStreamer(*OutStreamer, MCInstBuilder(RISCV::ADDI)
+                                     .addReg(MI.getOperand(0).getReg())
+                                     .addReg(MI.getOperand(1).getReg())
+                                     .addImm(MI.getOperand(3).getImm()));
+    return;
+  }
+  case RISCV::PseudoZiskMemcmpReg: {
+    // csrs 0x814, src ; add res, dst, sizereg
+    Csrs(CsrMemcmp, MI.getOperand(2).getReg());
+    EmitToStreamer(*OutStreamer, MCInstBuilder(RISCV::ADD)
+                                     .addReg(MI.getOperand(0).getReg())
+                                     .addReg(MI.getOperand(1).getReg())
+                                     .addReg(MI.getOperand(3).getReg()));
+    return;
+  }
+  case RISCV::PseudoZiskMemsetImm: {
+    // csrsi 0x816, 2 ; addi x0, dst, size ; addi x0, dst, val
+    Register Dst = MI.getOperand(0).getReg();
+    EmitToStreamer(*OutStreamer, MCInstBuilder(RISCV::CSRRSI)
+                                     .addReg(X0)
+                                     .addImm(CsrMemset)
+                                     .addImm(2));
+    EmitToStreamer(*OutStreamer, MCInstBuilder(RISCV::ADDI)
+                                     .addReg(X0)
+                                     .addReg(Dst)
+                                     .addImm(MI.getOperand(1).getImm()));
+    EmitToStreamer(*OutStreamer, MCInstBuilder(RISCV::ADDI)
+                                     .addReg(X0)
+                                     .addReg(Dst)
+                                     .addImm(MI.getOperand(2).getImm()));
+    return;
+  }
+  case RISCV::PseudoZiskMemsetReg: {
+    // csrs 0x816, dst ; addi x0, sizereg, val
+    Csrs(CsrMemset, MI.getOperand(0).getReg());
+    EmitToStreamer(*OutStreamer, MCInstBuilder(RISCV::ADDI)
+                                     .addReg(X0)
+                                     .addReg(MI.getOperand(1).getReg())
+                                     .addImm(MI.getOperand(2).getImm()));
+    return;
+  }
+  }
+}
