+// ZISK zkVM: lower memcpy/memset/memcmp to inline DMA precompile markers
+// (csrs 0x81x + add/addi) instead of emitting an ABI call. See
+// RISCVInstrInfoZisk.td and RISCVSelectionDAGInfo.cpp.
+def FeatureZiskDma
+   : SubtargetFeature<"zisk-dma", "HasZiskDma", "true",
+                      "Lower memcpy/memset/memcmp to ZISK DMA instructions">;
+def HasZiskDma : Predicate<"Subtarget->hasZiskDma()">,
+                 AssemblerPredicate<(all_of FeatureZiskDma),
+                     "'zisk-dma' (ZISK zkVM DMA lowering)">;
+
 def TuneNLogNVRGather
    : SubtargetFeature<"log-vrgather", "RISCVVRGatherCostModel", "NLog2N",
                       "Has vrgather.vv with LMUL*log2(LMUL) latency">;
diff --git a/llvm/lib/Target/RISCV/RISCVISelLowering.cpp b/llvm/lib/Target/RISCV/RISCVISelLowering.cpp
index 567ef2ff1..08b3d2aad 100644
--- a/llvm/lib/Target/RISCV/RISCVISelLowering.cpp
+++ b/llvm/lib/Target/RISCV/RISCVISelLowering.cpp
@@ -1683,6 +1683,28 @@ RISCVTargetLowering::RISCVTargetLowering(const TargetMachine &TM,
 
   MaxLoadsPerMemcmpOptSize = Subtarget.getMaxLoadsPerMemcmp(/*OptSize=*/true);
   MaxLoadsPerMemcmp = Subtarget.getMaxLoadsPerMemcmp(/*OptSize=*/false);
+
+  // ZISK zkVM: when the DMA precompile is available, cap the inline
+  // mem{cpy,set,move,cmp} expansion at a small size so that only tiny constant
+  // sizes are lowered to inline load/store sequences and everything larger is
+  // routed to the DMA precompile. SelectionDAG tries the inline expansion
+  // before consulting EmitTargetCodeForMem* (see SelectionDAG::getMemcpy), so
+  // the inline limit is what actually decides the boundary: a limit of 2 allows
+  // up to two XLen-sized memory ops (== 16 bytes on RV64, e.g. a 16-byte
+  // aligned copy as 2 ld + 2 sd) inline; any constant size needing 3+ ops (>16
+  // bytes) exceeds the limit and falls through to the DMA lowering. Keep this
+  // value in sync with ZiskDmaMaxInlineBytes in RISCVSelectionDAGInfo.cpp.
+  if (Subtarget.hasZiskDma()) {
+    MaxStoresPerMemsetOptSize = 2;
+    MaxStoresPerMemset = 2;
+    MaxGluedStoresPerMemcpy = 0;
+    MaxStoresPerMemcpyOptSize = 2;
+    MaxStoresPerMemcpy = 2;
+    MaxStoresPerMemmoveOptSize = 2;
+    MaxStoresPerMemmove = 2;
+    MaxLoadsPerMemcmpOptSize = 2;
+    MaxLoadsPerMemcmp = 2;
+  }
 }
 
